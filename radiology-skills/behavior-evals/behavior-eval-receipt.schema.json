{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/radiology-skills/behavior-eval-receipt.schema.json",
  "title": "Radiology Skills model behavior evaluation receipt",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_state",
    "captured_on",
    "installed_product",
    "cases_registry_path",
    "cases_registry_sha256",
    "capture_receipt_digest",
    "execution_identity",
    "evaluation_harness",
    "evaluated_skill_bundle",
    "outputs",
    "human_adjudication",
    "comparison_claim_eligible",
    "release_claim_eligible",
    "behavior_eval_receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.2"},
    "run_id": {"type": "string", "minLength": 1},
    "run_state": {"enum": ["PILOT_UNADJUDICATED", "HUMAN_ADJUDICATION_RECORDED"]},
    "captured_on": {"type": "string", "format": "date-time"},
    "installed_product": {
      "type": "object",
      "required": ["name", "version", "manifest_path", "manifest_sha256"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "cases_registry_path": {"type": "string", "minLength": 1},
    "cases_registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capture_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_identity": {
      "type": "object",
      "required": ["provider", "model", "model_version", "client", "system_context_digest"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "model_version": {"type": "string", "minLength": 1},
        "client": {"type": "string", "minLength": 1},
        "system_context_digest": {"type": "string", "pattern": "^(not-captured|[0-9a-f]{64})$"}
      },
      "additionalProperties": false
    },
    "evaluation_harness": {
      "type": "object",
      "required": ["harness_path", "file_count", "tree_sha256"],
      "properties": {
        "harness_path": {"type": "string", "minLength": 1},
        "file_count": {"type": "integer", "minimum": 1},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "evaluated_skill_bundle": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["skill_id", "skill_path", "file_count", "tree_sha256"],
        "properties": {
          "skill_id": {"type": "string", "pattern": "^radiology-[a-z0-9-]+$"},
          "skill_path": {"type": "string", "minLength": 1},
          "file_count": {"type": "integer", "minimum": 1},
          "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "prompt_sha256", "output_path", "output_sha256", "execution_state"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "output_path": {"type": "string", "minLength": 1},
          "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "execution_state": {"const": "MODEL_OUTPUT_CAPTURED"}
        },
        "additionalProperties": false
      }
    },
    "human_adjudication": {
      "type": "object",
      "required": ["status", "artifact_path", "artifact_sha256"],
      "properties": {
        "status": {"enum": ["NOT_ADJUDICATED", "HUMAN_ADJUDICATED"]},
        "artifact_path": {"type": "string"},
        "artifact_sha256": {"type": "string", "pattern": "^(|[0-9a-f]{64})$"}
      },
      "additionalProperties": false
    },
    "comparison_claim_eligible": {
      "const": false,
      "description": "Capture receipts cannot authorize cross-version comparison or maturity promotion."
    },
    "release_claim_eligible": {
      "const": false,
      "description": "This unauthenticated structural harness cannot issue a release behavior claim."
    },
    "behavior_eval_receipt_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
